<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only for ad-hoc builds (no Developer ID certificate).
  Hardened Runtime stays on, which keeps DYLD environment variable injection and
  debugger attachment blocked. Library validation is disabled because an ad-hoc
  signature has no Team ID, so macOS would otherwise refuse to load the bundled
  Sparkle.framework. Developer ID builds use WhatsClean.entitlements instead and
  keep library validation enabled.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
